{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openf1ow",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-04-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker handles these paths directly (slug recaps, insights listing,
    // OG image, OG injection on race pages, API proxy). Everything else
    // (static JS/CSS/images and SPA fallback) goes through the asset binding.
    "run_worker_first": [
      "/recap/*",
      "/insights",
      "/insights/*",
      "/about",
      "/about/",
      "/og-image",
      "/og-image/*",
      "/share/*",
      "/api/*",
      // Race pages: Worker injects per-page OG tags + JSON-LD into index.html.
      // Covers /:year, /:year/:mk, /:year/:mk/:sk/...
      "/2*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Public Worker variables (safe to commit — these aren't secrets).
  // GA_ID is the Google Analytics 4 measurement ID; the recap/insights
  // renderers inject the gtag snippet when this is set.
  "vars": {
    "GA_ID": "G-W8MHMCEZRQ"
  },
  "r2_buckets": [
    {
      "binding": "F1_DATA",
      "bucket_name": "openf1-data"
    }
  ],
  // Long-term usage history. The built-in GraphQL analytics only retain ~32
  // days (Workers) / 24h (zone HTTP), so we also write per-request data points
  // here — queryable for months via the Analytics Engine SQL API. The dataset
  // is created lazily on first write.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "openf1ow_usage"
    }
  ]
}

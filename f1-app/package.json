{
  "name": "f1-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "typecheck:ratchet": "node scripts/tsc-ratchet.mjs",
    "engine:check": "node --input-type=module -e \"await import('./src/engine/index.ts'); await import('./src/engine/telemetry/clipping.ts'); await import('./src/engine/telemetry/lapSegments.ts'); await import('./src/engine/telemetry/compare.ts'); await import('./src/lib/seasonUtils.ts')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/screens.mjs",
    "build": "npm run typecheck:ratchet && npm run engine:check && node scripts/gen-sitemap.mjs && vite build",
    "build:full": "node scripts/gen-race-index.mjs && npm run build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "scrape": "node scripts/scrape.mjs",
    "race-index": "node scripts/gen-race-index.mjs",
    "trends": "node scripts/compute-season-trends.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.0",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.80.0"
  }
}
